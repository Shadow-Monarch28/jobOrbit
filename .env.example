# Copy this file to .env.local and fill in your own Supabase project values.
# Get these from: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Adzuna (get free keys at https://developer.adzuna.com/)
VITE_ADZUNA_APP_ID=
VITE_ADZUNA_APP_KEY=

# Google Sign-In (get from Google Cloud Console -> Google Auth Platform -> Clients
# -> your OAuth client -> Client ID). This is the public Client ID only, ending in
# .apps.googleusercontent.com -- never put the Client Secret here, it's not needed
# in the frontend and must never be exposed to the browser.
VITE_GOOGLE_CLIENT_ID=
